import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
file_path = 'DataAnalys_C411.xlsx - Final_Form_Responses.csv'
df = pd.read_csv(file_path)
df_clean = df.rename(columns={
    'A1. Giới tính:': 'Gender',
    'A2. Ngành học:': 'Major',
    'A3. Sinh viên:': 'Year',
    'A4. Học lực học kỳ gần nhất:': 'GPA',
    'B1. Tổng thời lượng sử dụng trong ngày:': 'UsageTime'
})
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
sns.countplot(y='Major', data=df_clean, ax=axes[0, 0], 
              order=df_clean['Major'].value_counts().index, palette='viridis')
axes[0, 0].set_title('Phân bố theo Ngành học')
axes[0, 0].set_ylabel('')
sns.countplot(x='Year', data=df_clean, ax=axes[0, 1], 
              order=['1. Năm 1', '2. Năm 2', '3. Năm 3', '4. Năm 4'], palette='Blues')
axes[0, 1].set_title('Phân bố theo Năm sinh viên')
axes[0, 1].set_xlabel('')
sns.countplot(x='GPA', data=df_clean, ax=axes[1, 0], 
              order=['1. Xuất sắc', '2. Giỏi', '3. Khá', '4. Trung bình/Yếu'], palette='Magma')
axes[1, 0].set_title('Phân bố Học lực học kỳ gần nhất')
axes[1, 0].set_xlabel('')
sns.countplot(y='UsageTime', data=df_clean, ax=axes[1, 1], 
              order=['1. Nhỏ hơn 2 giờ', '2. Từ 2 đến 4 giờ', '3. Từ 4 đến 6 giờ', '4. Lớn hơn 6 giờ'], palette='Reds')
axes[1, 1].set_title('Thời lượng sử dụng Facebook hàng ngày')
axes[1, 1].set_ylabel('')
plt.tight_layout()
plt.savefig('demographics_summary.png')
plt.show()
df_score = df.copy()
likert_map = {
    'Rất đồng ý': 5, 'Đồng ý': 4, 'Bình thường': 3, 'Không đồng ý': 2, 'Rất không đồng ý': 1,
    'Rất cần thiết': 5, 'Cần thiết': 4, 'Trung tính': 3, 'Không cần thiết': 2, 'Rất không cần thiết': 1
}
gpa_map = {'1. Xuất sắc': 4, '2. Giỏi': 3, '3. Khá': 2, '4. Trung bình/Yếu': 1}
usage_map = {'1. Nhỏ hơn 2 giờ': 1, '2. Từ 2 đến 4 giờ': 2, '3. Từ 4 đến 6 giờ': 3, '4. Lớn hơn 6 giờ': 4}
df_score['GPA_Rank'] = df_clean['GPA'].map(gpa_map)
df_score['Usage_Rank'] = df_clean['UsageTime'].map(usage_map)
c1_cols = [c for c in df.columns if 'C1.' in c]
c2_cols = [c for c in df.columns if 'C2.' in c]
c3_cols = [c for c in df.columns if 'C3.' in c]
d_cols  = [c for c in df.columns if 'D1.' in c or 'D2.' in c or 'D3.' in c or 'D4.' in c]
positive_cols = [
    'C1. THÁI ĐỘ VÀ NẾP HỌC TẬP [C1.1. Tôi cảm thấy duy trì được sự tập trung tốt trong quá trình học tập]',
    'C2. KẾ HOẠCH HỌC TẬP VÀ VIỆC PHÂN BỔ THỜI GIAN CỦA BẢN THÂN [C2.1. Tôi có thể lập kế hoạch và phân bổ thời gian hợp lý giữa học tập và dùng Facebook]',
    'C2. KẾ HOẠCH HỌC TẬP VÀ VIỆC PHÂN BỔ THỜI GIAN CỦA BẢN THÂN [C2.2. Tôi thường tuân thủ đúng lịch trình học tập đã đặt ra dù có sử dụng Facebook]'
]
for col in c1_cols + c2_cols + c3_cols:
    df_score[col] = df_score[col].map(likert_map)
    if col in positive_cols:
        df_score[col] = 6 - df_score[col] # Đảo ngược: 5->1, 1->5
df_score['Impact_Attitude'] = df_score[c1_cols].mean(axis=1) # Tác động thái độ
df_score['Impact_Planning'] = df_score[c2_cols].mean(axis=1) # Tác động kế hoạch
df_score['Impact_Pressure'] = df_score[c3_cols].mean(axis=1) # Áp lực đồng trang lứa
df_score['Total_Negative_Score'] = df_score[['Impact_Attitude', 'Impact_Planning', 'Impact_Pressure']].mean(axis=1)
corr_cols = ['Usage_Rank', 'GPA_Rank', 'Impact_Attitude', 'Impact_Planning', 'Impact_Pressure', 'Total_Negative_Score']
correlation = df_score[corr_cols].corr()
plt.figure(figsize=(10, 8))
sns.heatmap(correlation, annot=True, cmap='coolwarm', fmt=".2f")
plt.title('Ma trận tương quan: Thời gian dùng, GPA và Tác động tiêu cực')
plt.savefig('correlation_matrix.png')
plt.show()
for col in d_cols:
    df_score[col] = df.loc[:, col].map(likert_map)
top_solutions = df_score[d_cols].mean().sort_values(ascending=False).head(5)
short_labels = [label.split('[')[-1].replace(']', '') for label in top_solutions.index]
plt.figure(figsize=(10, 5))
sns.barplot(x=top_solutions.values, y=short_labels, palette='Greens_r')
plt.title('Top 5 Giải pháp được sinh viên đánh giá là Cần thiết nhất')
plt.xlabel('Điểm trung bình (1-5)')
plt.tight_layout()
plt.savefig('top_solutions.png')
plt.show()
print("Hoàn tất phân tích. Các biểu đồ đã được lưu.")
